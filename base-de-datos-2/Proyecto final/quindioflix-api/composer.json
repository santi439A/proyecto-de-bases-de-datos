{
    "name": "quindioflix/api",
    "description": "QuindioFlix Backend API",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "firebase/php-jwt": "^6.11",
        "symfony/dotenv": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "audit": {
            "block-insecure": false
        }
    }
}