digraph QuindioFlix_MER {
    graph [
        label="MODELO ENTIDAD-RELACION - QUINDIOFLIX"
        rankdir=TB
        newrank=true
        nodesep=0.55
        ranksep=0.85
        pad=0.25
        margin=0.1
        dpi=140
        fontsize=16
        fontname="Arial Bold"
        bgcolor=white
    ];

    node [shape=plain fontname="Arial" fontsize=10];
    edge [color="#495057" penwidth=1.1 arrowsize=0.45 fontname="Arial Bold" fontsize=8];

    subgraph cluster_maestras {
        label="1. ENTIDADES MAESTRAS";
        style=filled;
        color="#28a745";
        bgcolor="#f4fff6";

        PLAN [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#d4edda">
<TR><TD COLSPAN="2" BGCOLOR="#28a745"><FONT COLOR="white"><B>PLAN</B></FONT></TD></TR>
<TR><TD><U>plan_id</U></TD><TD></TD></TR>
<TR><TD>nombre</TD><TD></TD></TR>
<TR><TD>precio_mensual</TD><TD></TD></TR>
<TR><TD>num_pantallas</TD><TD></TD></TR>
<TR><TD>max_perfiles</TD><TD></TD></TR>
<TR><TD>calidad</TD><TD></TD></TR>
</TABLE>>];

        CATEGORIA [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#d4edda">
<TR><TD COLSPAN="2" BGCOLOR="#28a745"><FONT COLOR="white"><B>CATEGORIA</B></FONT></TD></TR>
<TR><TD><U>categoria_id</U></TD><TD></TD></TR>
<TR><TD>nombre</TD><TD></TD></TR>
</TABLE>>];

        GENERO [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#d4edda">
<TR><TD COLSPAN="2" BGCOLOR="#28a745"><FONT COLOR="white"><B>GENERO</B></FONT></TD></TR>
<TR><TD><U>genero_id</U></TD><TD></TD></TR>
<TR><TD>nombre</TD><TD></TD></TR>
</TABLE>>];

        DEPARTAMENTO [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#d4edda">
<TR><TD COLSPAN="2" BGCOLOR="#28a745"><FONT COLOR="white"><B>DEPARTAMENTO</B></FONT></TD></TR>
<TR><TD><U>departamento_id</U></TD><TD></TD></TR>
<TR><TD>nombre</TD><TD></TD></TR>
<TR><TD>jefe_id</TD><TD>(FK)</TD></TR>
</TABLE>>];
    }

    subgraph cluster_equipo {
        label="2. EQUIPO DE TRABAJO";
        style=filled;
        color="#17a2b8";
        bgcolor="#eefcff";

        EMPLEADO [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#d1ecf1">
<TR><TD COLSPAN="2" BGCOLOR="#17a2b8"><FONT COLOR="white"><B>EMPLEADO</B></FONT></TD></TR>
<TR><TD><U>empleado_id</U></TD><TD></TD></TR>
<TR><TD>nombre</TD><TD></TD></TR>
<TR><TD>email</TD><TD></TD></TR>
<TR><TD>telefono</TD><TD></TD></TR>
<TR><TD>cargo</TD><TD></TD></TR>
<TR><TD>departamento_id</TD><TD>(FK)</TD></TR>
<TR><TD>supervisor_id</TD><TD>(FK)</TD></TR>
</TABLE>>];
    }

    subgraph cluster_contenido {
        label="3. CATALOGO MULTIMEDIA";
        style=filled;
        color="#007bff";
        bgcolor="#f2f8ff";

        CONTENIDO [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f4fd">
<TR><TD COLSPAN="2" BGCOLOR="#007bff"><FONT COLOR="white"><B>CONTENIDO</B></FONT></TD></TR>
<TR><TD><U>contenido_id</U></TD><TD></TD></TR>
<TR><TD>categoria_id</TD><TD>(FK)</TD></TR>
<TR><TD>titulo</TD><TD></TD></TR>
<TR><TD>anno_lanzamiento</TD><TD></TD></TR>
<TR><TD>duracion_minutos</TD><TD></TD></TR>
<TR><TD>sinopsis</TD><TD></TD></TR>
<TR><TD>clasificacion_edad</TD><TD></TD></TR>
<TR><TD>fecha_agregado</TD><TD></TD></TR>
<TR><TD>es_original</TD><TD></TD></TR>
<TR><TD>empleado_responsable_id</TD><TD>(FK)</TD></TR>
</TABLE>>];

        CONTENIDO_GENERO [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f4fd">
<TR><TD COLSPAN="2" BGCOLOR="#007bff"><FONT COLOR="white"><B>CONTENIDO_GENERO</B></FONT></TD></TR>
<TR><TD><U>contenido_id</U></TD><TD>(PK)(FK)</TD></TR>
<TR><TD><U>genero_id</U></TD><TD>(PK)(FK)</TD></TR>
</TABLE>>];

        CONTENIDO_RELACIONADO [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f4fd">
<TR><TD COLSPAN="2" BGCOLOR="#007bff"><FONT COLOR="white"><B>CONTENIDO_RELACIONADO</B></FONT></TD></TR>
<TR><TD><U>contenido_origen_id</U></TD><TD>(PK)(FK)</TD></TR>
<TR><TD><U>contenido_relacionado_id</U></TD><TD>(PK)(FK)</TD></TR>
<TR><TD>tipo_relacion</TD><TD></TD></TR>
</TABLE>>];

        TEMPORADA [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f4fd">
<TR><TD COLSPAN="2" BGCOLOR="#007bff"><FONT COLOR="white"><B>TEMPORADA</B></FONT></TD></TR>
<TR><TD><U>temporada_id</U></TD><TD></TD></TR>
<TR><TD>contenido_id</TD><TD>(FK)</TD></TR>
<TR><TD>numero</TD><TD></TD></TR>
</TABLE>>];

        EPISODIO [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f4fd">
<TR><TD COLSPAN="2" BGCOLOR="#007bff"><FONT COLOR="white"><B>EPISODIO</B></FONT></TD></TR>
<TR><TD><U>episodio_id</U></TD><TD></TD></TR>
<TR><TD>temporada_id</TD><TD>(FK)</TD></TR>
<TR><TD>numero</TD><TD></TD></TR>
<TR><TD>titulo</TD><TD></TD></TR>
<TR><TD>duracion_minutos</TD><TD></TD></TR>
</TABLE>>];
    }

    subgraph cluster_usuarios {
        label="4. USUARIOS Y CONSUMO";
        style=filled;
        color="#ffc107";
        bgcolor="#fffdf1";

        USUARIO [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff3cd">
<TR><TD COLSPAN="2" BGCOLOR="#ffc107"><FONT COLOR="white"><B>USUARIO</B></FONT></TD></TR>
<TR><TD><U>usuario_id</U></TD><TD></TD></TR>
<TR><TD>nombre</TD><TD></TD></TR>
<TR><TD>email</TD><TD></TD></TR>
<TR><TD>telefono</TD><TD></TD></TR>
<TR><TD>fecha_nacimiento</TD><TD></TD></TR>
<TR><TD>ciudad_residencia</TD><TD></TD></TR>
<TR><TD>plan_id</TD><TD>(FK)</TD></TR>
<TR><TD>fecha_registro</TD><TD></TD></TR>
<TR><TD>estado_cuenta</TD><TD></TD></TR>
<TR><TD>fecha_ultimo_pago</TD><TD></TD></TR>
</TABLE>>];

        PERFIL [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff3cd">
<TR><TD COLSPAN="2" BGCOLOR="#ffc107"><FONT COLOR="white"><B>PERFIL</B></FONT></TD></TR>
<TR><TD><U>perfil_id</U></TD><TD></TD></TR>
<TR><TD>usuario_id</TD><TD>(FK)</TD></TR>
<TR><TD>nombre</TD><TD></TD></TR>
<TR><TD>avatar</TD><TD></TD></TR>
<TR><TD>tipo</TD><TD></TD></TR>
</TABLE>>];

        REFERIDO [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff3cd">
<TR><TD COLSPAN="2" BGCOLOR="#ffc107"><FONT COLOR="white"><B>REFERIDO</B></FONT></TD></TR>
<TR><TD><U>referido_id</U></TD><TD></TD></TR>
<TR><TD>usuario_referidor_id</TD><TD>(FK)</TD></TR>
<TR><TD>usuario_referido_id</TD><TD>(FK)</TD></TR>
<TR><TD>beneficio</TD><TD></TD></TR>
<TR><TD>estado_beneficio</TD><TD></TD></TR>
<TR><TD>fecha_referido</TD><TD></TD></TR>
</TABLE>>];

        REPRODUCCION [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff3cd">
<TR><TD COLSPAN="2" BGCOLOR="#ffc107"><FONT COLOR="white"><B>REPRODUCCION</B></FONT></TD></TR>
<TR><TD><U>reproduccion_id</U></TD><TD></TD></TR>
<TR><TD>perfil_id</TD><TD>(FK)</TD></TR>
<TR><TD>contenido_id</TD><TD>(FK)</TD></TR>
<TR><TD>episodio_id</TD><TD>(FK)</TD></TR>
<TR><TD>fecha_inicio</TD><TD></TD></TR>
<TR><TD>fecha_fin</TD><TD></TD></TR>
<TR><TD>dispositivo</TD><TD></TD></TR>
<TR><TD>porcentaje_avance</TD><TD></TD></TR>
</TABLE>>];

        FAVORITO [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff3cd">
<TR><TD COLSPAN="2" BGCOLOR="#ffc107"><FONT COLOR="white"><B>FAVORITO</B></FONT></TD></TR>
<TR><TD><U>perfil_id</U></TD><TD>(PK)(FK)</TD></TR>
<TR><TD><U>contenido_id</U></TD><TD>(PK)(FK)</TD></TR>
<TR><TD>fecha_agregado</TD><TD></TD></TR>
</TABLE>>];

        RESENA [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff3cd">
<TR><TD COLSPAN="2" BGCOLOR="#ffc107"><FONT COLOR="white"><B>RESENA</B></FONT></TD></TR>
<TR><TD><U>resena_id</U></TD><TD></TD></TR>
<TR><TD>perfil_id</TD><TD>(FK)</TD></TR>
<TR><TD>contenido_id</TD><TD>(FK)</TD></TR>
<TR><TD>calificacion</TD><TD></TD></TR>
<TR><TD>texto</TD><TD></TD></TR>
<TR><TD>fecha_publicacion</TD><TD></TD></TR>
</TABLE>>];

        REPORTE [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff3cd">
<TR><TD COLSPAN="2" BGCOLOR="#ffc107"><FONT COLOR="white"><B>REPORTE</B></FONT></TD></TR>
<TR><TD><U>reporte_id</U></TD><TD></TD></TR>
<TR><TD>contenido_id</TD><TD>(FK)</TD></TR>
<TR><TD>perfil_id</TD><TD>(FK)</TD></TR>
<TR><TD>moderador_id</TD><TD>(FK)</TD></TR>
<TR><TD>motivo</TD><TD></TD></TR>
<TR><TD>estado</TD><TD></TD></TR>
<TR><TD>fecha_reporte</TD><TD></TD></TR>
<TR><TD>fecha_resolucion</TD><TD></TD></TR>
</TABLE>>];
    }

    subgraph cluster_finanzas {
        label="5. FACTURACION Y PAGOS";
        style=filled;
        color="#dc3545";
        bgcolor="#fff5f5";

        FACTURA [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f8d7da">
<TR><TD COLSPAN="2" BGCOLOR="#dc3545"><FONT COLOR="white"><B>FACTURA</B></FONT></TD></TR>
<TR><TD><U>factura_id</U></TD><TD></TD></TR>
<TR><TD>usuario_id</TD><TD>(FK)</TD></TR>
<TR><TD>periodo</TD><TD></TD></TR>
<TR><TD>monto_total</TD><TD></TD></TR>
<TR><TD>estado_factura</TD><TD></TD></TR>
<TR><TD>fecha_emision</TD><TD></TD></TR>
<TR><TD>fecha_vencimiento</TD><TD></TD></TR>
</TABLE>>];

        PAGO [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f8d7da">
<TR><TD COLSPAN="2" BGCOLOR="#dc3545"><FONT COLOR="white"><B>PAGO</B></FONT></TD></TR>
<TR><TD><U>pago_id</U></TD><TD></TD></TR>
<TR><TD>factura_id</TD><TD>(FK)</TD></TR>
<TR><TD>fecha_pago</TD><TD></TD></TR>
<TR><TD>monto_pagado</TD><TD></TD></TR>
<TR><TD>metodo_pago</TD><TD></TD></TR>
<TR><TD>estado_pago</TD><TD></TD></TR>
<TR><TD>referencia</TD><TD></TD></TR>
</TABLE>>];
    }

    PLAN -> USUARIO [label="1:N"];
    DEPARTAMENTO -> EMPLEADO [label="1:N"];
    DEPARTAMENTO -> EMPLEADO [label="1:1 jefe" style=dashed color="#17a2b8" constraint=false];
    EMPLEADO -> EMPLEADO [label="1:N supervisa" style=dashed color="#17a2b8"];

    CATEGORIA -> CONTENIDO [label="1:N"];
    EMPLEADO -> CONTENIDO [label="1:N responsable" color="#007bff"];
    CONTENIDO -> CONTENIDO_GENERO [label="1:N"];
    GENERO -> CONTENIDO_GENERO [label="1:N"];
    CONTENIDO -> CONTENIDO_RELACIONADO [label="1:N relacionada" style=dashed];
    CONTENIDO -> TEMPORADA [label="1:N"];
    TEMPORADA -> EPISODIO [label="1:N"];

    USUARIO -> PERFIL [label="1:N"];
    USUARIO -> REFERIDO [label="1:N refiere" style=dashed];
    PERFIL -> REPRODUCCION [label="1:N"];
    PERFIL -> FAVORITO [label="1:N"];
    PERFIL -> RESENA [label="1:N"];
    PERFIL -> REPORTE [label="1:N"];
    CONTENIDO -> REPRODUCCION [label="1:N"];
    CONTENIDO -> FAVORITO [label="1:N"];
    CONTENIDO -> RESENA [label="1:N"];
    CONTENIDO -> REPORTE [label="1:N"];
    EMPLEADO -> REPORTE [label="1:N moderador" color="#ffc107"];

    USUARIO -> FACTURA [label="1:N" color="#dc3545" constraint=false];
    FACTURA -> PAGO [label="1:N" color="#dc3545"];

    {rank=same; PLAN; CATEGORIA; GENERO; DEPARTAMENTO; FACTURA; PAGO}
    {rank=same; EMPLEADO; CONTENIDO; TEMPORADA; EPISODIO}
    {rank=same; USUARIO; PERFIL; REFERIDO}
    {rank=same; REPRODUCCION; FAVORITO; RESENA; REPORTE}
}
