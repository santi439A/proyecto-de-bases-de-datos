digraph QuindioFlix_Logico {
    graph [
        label="DIAGRAMA LOGICO RELACIONAL - QUINDIOFLIX"
        rankdir=TB
        newrank=true
        nodesep=0.6
        ranksep=0.9
        pad=0.25
        margin=0.1
        dpi=140
        fontsize=16
        fontname="Arial Bold"
        bgcolor=white
    ];

    node [shape=plain fontname="Arial" fontsize=9];
    edge [color="#495057" penwidth=0.95 arrowsize=0.42 fontname="Arial Bold" fontsize=8];

    subgraph cluster_maestras {
        label="1. TABLAS MAESTRAS";
        style=filled;
        color="#28a745";
        bgcolor="#f4fff6";

        PLAN [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#d4edda">
<TR><TD COLSPAN="3" BGCOLOR="#28a745"><FONT COLOR="white"><B>PLAN</B></FONT></TD></TR>
<TR><TD><B>PK</B></TD><TD><U>plan_id</U></TD><TD>NUMBER(2)</TD></TR>
<TR><TD></TD><TD>nombre</TD><TD>VARCHAR2(20) NOT NULL UNIQUE</TD></TR>
<TR><TD></TD><TD>precio_mensual</TD><TD>NUMBER(10,2) NOT NULL</TD></TR>
<TR><TD></TD><TD>num_pantallas</TD><TD>NUMBER(1) NOT NULL</TD></TR>
<TR><TD></TD><TD>max_perfiles</TD><TD>NUMBER(1) NOT NULL</TD></TR>
<TR><TD></TD><TD>calidad</TD><TD>VARCHAR2(10) CHECK(IN('SD','HD','4K'))</TD></TR>
</TABLE>>];

        CATEGORIA [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#d4edda">
<TR><TD COLSPAN="3" BGCOLOR="#28a745"><FONT COLOR="white"><B>CATEGORIA</B></FONT></TD></TR>
<TR><TD><B>PK</B></TD><TD><U>categoria_id</U></TD><TD>NUMBER(2)</TD></TR>
<TR><TD></TD><TD>nombre</TD><TD>VARCHAR2(30) NOT NULL UNIQUE</TD></TR>
</TABLE>>];

        GENERO [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#d4edda">
<TR><TD COLSPAN="3" BGCOLOR="#28a745"><FONT COLOR="white"><B>GENERO</B></FONT></TD></TR>
<TR><TD><B>PK</B></TD><TD><U>genero_id</U></TD><TD>NUMBER(3)</TD></TR>
<TR><TD></TD><TD>nombre</TD><TD>VARCHAR2(50) NOT NULL UNIQUE</TD></TR>
</TABLE>>];

        DEPARTAMENTO [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#d4edda">
<TR><TD COLSPAN="3" BGCOLOR="#28a745"><FONT COLOR="white"><B>DEPARTAMENTO</B></FONT></TD></TR>
<TR><TD><B>PK</B></TD><TD><U>departamento_id</U></TD><TD>NUMBER(3)</TD></TR>
<TR><TD></TD><TD>nombre</TD><TD>VARCHAR2(50) NOT NULL UNIQUE</TD></TR>
<TR><TD><B>FK</B></TD><TD>jefe_id</TD><TD>NUMBER(5)</TD></TR>
</TABLE>>];
    }

    subgraph cluster_equipo {
        label="2. EQUIPO DE TRABAJO";
        style=filled;
        color="#17a2b8";
        bgcolor="#eefcff";

        EMPLEADO [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#d1ecf1">
<TR><TD COLSPAN="3" BGCOLOR="#17a2b8"><FONT COLOR="white"><B>EMPLEADO</B></FONT></TD></TR>
<TR><TD><B>PK</B></TD><TD><U>empleado_id</U></TD><TD>NUMBER(5)</TD></TR>
<TR><TD></TD><TD>nombre</TD><TD>VARCHAR2(100) NOT NULL</TD></TR>
<TR><TD></TD><TD>email</TD><TD>VARCHAR2(100) NOT NULL UNIQUE</TD></TR>
<TR><TD></TD><TD>telefono</TD><TD>VARCHAR2(20)</TD></TR>
<TR><TD></TD><TD>cargo</TD><TD>VARCHAR2(50) NOT NULL</TD></TR>
<TR><TD><B>FK</B></TD><TD>departamento_id</TD><TD>NUMBER(3) NOT NULL</TD></TR>
<TR><TD><B>FK</B></TD><TD>supervisor_id</TD><TD>NUMBER(5)</TD></TR>
</TABLE>>];
    }

    subgraph cluster_contenido {
        label="3. CATALOGO MULTIMEDIA";
        style=filled;
        color="#007bff";
        bgcolor="#f2f8ff";

        CONTENIDO [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f4fd">
<TR><TD COLSPAN="3" BGCOLOR="#007bff"><FONT COLOR="white"><B>CONTENIDO</B></FONT></TD></TR>
<TR><TD><B>PK</B></TD><TD><U>contenido_id</U></TD><TD>NUMBER(5)</TD></TR>
<TR><TD><B>FK</B></TD><TD>categoria_id</TD><TD>NUMBER(2) NOT NULL</TD></TR>
<TR><TD></TD><TD>titulo</TD><TD>VARCHAR2(200) NOT NULL</TD></TR>
<TR><TD></TD><TD>anno_lanzamiento</TD><TD>NUMBER(4) NOT NULL</TD></TR>
<TR><TD></TD><TD>duracion_minutos</TD><TD>NUMBER(5)</TD></TR>
<TR><TD></TD><TD>sinopsis</TD><TD>CLOB</TD></TR>
<TR><TD></TD><TD>clasificacion_edad</TD><TD>VARCHAR2(5) CHECK(IN('TP','+7','+13','+16','+18'))</TD></TR>
<TR><TD></TD><TD>fecha_agregado</TD><TD>DATE NOT NULL</TD></TR>
<TR><TD></TD><TD>es_original</TD><TD>NUMBER(1) CHECK(IN(0,1))</TD></TR>
<TR><TD><B>FK</B></TD><TD>empleado_responsable_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
</TABLE>>];

        CONTENIDO_GENERO [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f4fd">
<TR><TD COLSPAN="3" BGCOLOR="#007bff"><FONT COLOR="white"><B>CONTENIDO_GENERO</B></FONT></TD></TR>
<TR><TD><B>PK,FK</B></TD><TD><U>contenido_id</U></TD><TD>NUMBER(5)</TD></TR>
<TR><TD><B>PK,FK</B></TD><TD><U>genero_id</U></TD><TD>NUMBER(3)</TD></TR>
</TABLE>>];

        CONTENIDO_RELACIONADO [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f4fd">
<TR><TD COLSPAN="3" BGCOLOR="#007bff"><FONT COLOR="white"><B>CONTENIDO_RELACIONADO</B></FONT></TD></TR>
<TR><TD><B>PK,FK</B></TD><TD><U>contenido_origen_id</U></TD><TD>NUMBER(5)</TD></TR>
<TR><TD><B>PK,FK</B></TD><TD><U>contenido_relacionado_id</U></TD><TD>NUMBER(5)</TD></TR>
<TR><TD></TD><TD>tipo_relacion</TD><TD>VARCHAR2(30) NOT NULL</TD></TR>
</TABLE>>];

        TEMPORADA [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f4fd">
<TR><TD COLSPAN="3" BGCOLOR="#007bff"><FONT COLOR="white"><B>TEMPORADA</B></FONT></TD></TR>
<TR><TD><B>PK</B></TD><TD><U>temporada_id</U></TD><TD>NUMBER(5)</TD></TR>
<TR><TD><B>FK</B></TD><TD>contenido_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD></TD><TD>numero</TD><TD>NUMBER(2) NOT NULL</TD></TR>
</TABLE>>];

        EPISODIO [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8f4fd">
<TR><TD COLSPAN="3" BGCOLOR="#007bff"><FONT COLOR="white"><B>EPISODIO</B></FONT></TD></TR>
<TR><TD><B>PK</B></TD><TD><U>episodio_id</U></TD><TD>NUMBER(5)</TD></TR>
<TR><TD><B>FK</B></TD><TD>temporada_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD></TD><TD>numero</TD><TD>NUMBER(3) NOT NULL</TD></TR>
<TR><TD></TD><TD>titulo</TD><TD>VARCHAR2(200) NOT NULL</TD></TR>
<TR><TD></TD><TD>duracion_minutos</TD><TD>NUMBER(5) NOT NULL</TD></TR>
</TABLE>>];
    }

    subgraph cluster_usuarios {
        label="4. USUARIOS Y CONSUMO";
        style=filled;
        color="#ffc107";
        bgcolor="#fffdf1";

        USUARIO [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff3cd">
<TR><TD COLSPAN="3" BGCOLOR="#ffc107"><FONT COLOR="white"><B>USUARIO</B></FONT></TD></TR>
<TR><TD><B>PK</B></TD><TD><U>usuario_id</U></TD><TD>NUMBER(5)</TD></TR>
<TR><TD></TD><TD>nombre</TD><TD>VARCHAR2(100) NOT NULL</TD></TR>
<TR><TD></TD><TD>email</TD><TD>VARCHAR2(100) NOT NULL UNIQUE</TD></TR>
<TR><TD></TD><TD>telefono</TD><TD>VARCHAR2(20)</TD></TR>
<TR><TD></TD><TD>fecha_nacimiento</TD><TD>DATE NOT NULL</TD></TR>
<TR><TD></TD><TD>ciudad_residencia</TD><TD>VARCHAR2(100) NOT NULL</TD></TR>
<TR><TD><B>FK</B></TD><TD>plan_id</TD><TD>NUMBER(2) NOT NULL</TD></TR>
<TR><TD></TD><TD>fecha_registro</TD><TD>DATE NOT NULL</TD></TR>
<TR><TD></TD><TD>estado_cuenta</TD><TD>VARCHAR2(12) CHECK(IN('ACTIVO','SUSPENDIDO','INACTIVO'))</TD></TR>
<TR><TD></TD><TD>fecha_ultimo_pago</TD><TD>DATE</TD></TR>
</TABLE>>];

        PERFIL [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff3cd">
<TR><TD COLSPAN="3" BGCOLOR="#ffc107"><FONT COLOR="white"><B>PERFIL</B></FONT></TD></TR>
<TR><TD><B>PK</B></TD><TD><U>perfil_id</U></TD><TD>NUMBER(5)</TD></TR>
<TR><TD><B>FK</B></TD><TD>usuario_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD></TD><TD>nombre</TD><TD>VARCHAR2(50) NOT NULL</TD></TR>
<TR><TD></TD><TD>avatar</TD><TD>VARCHAR2(200)</TD></TR>
<TR><TD></TD><TD>tipo</TD><TD>VARCHAR2(10) CHECK(IN('ADULTO','INFANTIL'))</TD></TR>
</TABLE>>];

        REFERIDO [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff3cd">
<TR><TD COLSPAN="3" BGCOLOR="#ffc107"><FONT COLOR="white"><B>REFERIDO</B></FONT></TD></TR>
<TR><TD><B>PK</B></TD><TD><U>referido_id</U></TD><TD>NUMBER(5)</TD></TR>
<TR><TD><B>FK</B></TD><TD>usuario_referidor_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD><B>FK</B></TD><TD>usuario_referido_id</TD><TD>NUMBER(5) NOT NULL UNIQUE</TD></TR>
<TR><TD></TD><TD>beneficio</TD><TD>VARCHAR2(100)</TD></TR>
<TR><TD></TD><TD>estado_beneficio</TD><TD>VARCHAR2(15) CHECK(IN('PENDIENTE','APLICADO','VENCIDO'))</TD></TR>
<TR><TD></TD><TD>fecha_referido</TD><TD>DATE NOT NULL</TD></TR>
</TABLE>>];

        REPRODUCCION [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff3cd">
<TR><TD COLSPAN="3" BGCOLOR="#ffc107"><FONT COLOR="white"><B>REPRODUCCION</B></FONT></TD></TR>
<TR><TD><B>PK</B></TD><TD><U>reproduccion_id</U></TD><TD>NUMBER(10)</TD></TR>
<TR><TD><B>FK</B></TD><TD>perfil_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD><B>FK</B></TD><TD>contenido_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD><B>FK</B></TD><TD>episodio_id</TD><TD>NUMBER(5)</TD></TR>
<TR><TD></TD><TD>fecha_inicio</TD><TD>TIMESTAMP NOT NULL</TD></TR>
<TR><TD></TD><TD>fecha_fin</TD><TD>TIMESTAMP</TD></TR>
<TR><TD></TD><TD>dispositivo</TD><TD>VARCHAR2(20) CHECK(IN('CELULAR','TABLET','TV','COMPUTADOR'))</TD></TR>
<TR><TD></TD><TD>porcentaje_avance</TD><TD>NUMBER(5,2) CHECK(BETWEEN 0 AND 100)</TD></TR>
</TABLE>>];

        FAVORITO [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff3cd">
<TR><TD COLSPAN="3" BGCOLOR="#ffc107"><FONT COLOR="white"><B>FAVORITO</B></FONT></TD></TR>
<TR><TD><B>PK,FK</B></TD><TD><U>perfil_id</U></TD><TD>NUMBER(5)</TD></TR>
<TR><TD><B>PK,FK</B></TD><TD><U>contenido_id</U></TD><TD>NUMBER(5)</TD></TR>
<TR><TD></TD><TD>fecha_agregado</TD><TD>DATE NOT NULL</TD></TR>
</TABLE>>];

        RESENA [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff3cd">
<TR><TD COLSPAN="3" BGCOLOR="#ffc107"><FONT COLOR="white"><B>RESENA</B></FONT></TD></TR>
<TR><TD><B>PK</B></TD><TD><U>resena_id</U></TD><TD>NUMBER(10)</TD></TR>
<TR><TD><B>FK</B></TD><TD>perfil_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD><B>FK</B></TD><TD>contenido_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD></TD><TD>calificacion</TD><TD>NUMBER(1) CHECK(BETWEEN 1 AND 5)</TD></TR>
<TR><TD></TD><TD>texto</TD><TD>CLOB</TD></TR>
<TR><TD></TD><TD>fecha_publicacion</TD><TD>DATE NOT NULL</TD></TR>
</TABLE>>];

        REPORTE [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff3cd">
<TR><TD COLSPAN="3" BGCOLOR="#ffc107"><FONT COLOR="white"><B>REPORTE</B></FONT></TD></TR>
<TR><TD><B>PK</B></TD><TD><U>reporte_id</U></TD><TD>NUMBER(10)</TD></TR>
<TR><TD><B>FK</B></TD><TD>contenido_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD><B>FK</B></TD><TD>perfil_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD><B>FK</B></TD><TD>moderador_id</TD><TD>NUMBER(5)</TD></TR>
<TR><TD></TD><TD>motivo</TD><TD>VARCHAR2(500) NOT NULL</TD></TR>
<TR><TD></TD><TD>estado</TD><TD>VARCHAR2(20) CHECK(IN('PENDIENTE','EN_REVISION','APROBADO','RECHAZADO'))</TD></TR>
<TR><TD></TD><TD>fecha_reporte</TD><TD>DATE NOT NULL</TD></TR>
<TR><TD></TD><TD>fecha_resolucion</TD><TD>DATE</TD></TR>
</TABLE>>];
    }

    subgraph cluster_finanzas {
        label="5. FACTURACION Y PAGOS";
        style=filled;
        color="#dc3545";
        bgcolor="#fff5f5";

        FACTURA [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f8d7da">
<TR><TD COLSPAN="3" BGCOLOR="#dc3545"><FONT COLOR="white"><B>FACTURA</B></FONT></TD></TR>
<TR><TD><B>PK</B></TD><TD><U>factura_id</U></TD><TD>NUMBER(10)</TD></TR>
<TR><TD><B>FK</B></TD><TD>usuario_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD></TD><TD>periodo</TD><TD>VARCHAR2(7) NOT NULL</TD></TR>
<TR><TD></TD><TD>monto_total</TD><TD>NUMBER(10,2) NOT NULL</TD></TR>
<TR><TD></TD><TD>estado_factura</TD><TD>VARCHAR2(15) CHECK(IN('PENDIENTE','PAGADA','VENCIDA','ANULADA'))</TD></TR>
<TR><TD></TD><TD>fecha_emision</TD><TD>DATE NOT NULL</TD></TR>
<TR><TD></TD><TD>fecha_vencimiento</TD><TD>DATE NOT NULL</TD></TR>
</TABLE>>];

        PAGO [label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f8d7da">
<TR><TD COLSPAN="3" BGCOLOR="#dc3545"><FONT COLOR="white"><B>PAGO</B></FONT></TD></TR>
<TR><TD><B>PK</B></TD><TD><U>pago_id</U></TD><TD>NUMBER(10)</TD></TR>
<TR><TD><B>FK</B></TD><TD>factura_id</TD><TD>NUMBER(10) NOT NULL</TD></TR>
<TR><TD></TD><TD>fecha_pago</TD><TD>DATE NOT NULL</TD></TR>
<TR><TD></TD><TD>monto_pagado</TD><TD>NUMBER(10,2) NOT NULL</TD></TR>
<TR><TD></TD><TD>metodo_pago</TD><TD>VARCHAR2(20) CHECK(IN('TCREDITO','TDEBITO','PSE','NEQUI','DAVIPLATA'))</TD></TR>
<TR><TD></TD><TD>estado_pago</TD><TD>VARCHAR2(15) CHECK(IN('EXITOSO','FALLIDO','PENDIENTE','REEMBOLSADO'))</TD></TR>
<TR><TD></TD><TD>referencia</TD><TD>VARCHAR2(100)</TD></TR>
</TABLE>>];
    }

    PLAN -> USUARIO [label="1:N"];
    DEPARTAMENTO -> EMPLEADO [label="1:N"];
    DEPARTAMENTO -> EMPLEADO [label="1:1 jefe" style=dashed color="#17a2b8" constraint=false];
    EMPLEADO -> EMPLEADO [label="1:N supervisa" style=dashed color="#17a2b8"];

    CATEGORIA -> CONTENIDO [label="1:N"];
    EMPLEADO -> CONTENIDO [label="1:N responsable" color="#007bff"];
    CONTENIDO -> CONTENIDO_GENERO [label="1:N"];
    GENERO -> CONTENIDO_GENERO [label="1:N"];
    CONTENIDO -> CONTENIDO_RELACIONADO [label="1:N reflexiva" style=dashed];
    CONTENIDO -> TEMPORADA [label="1:N"];
    TEMPORADA -> EPISODIO [label="1:N"];

    USUARIO -> PERFIL [label="1:N"];
    USUARIO -> REFERIDO [label="1:N refiere" style=dashed];
    PERFIL -> REPRODUCCION [label="1:N"];
    PERFIL -> FAVORITO [label="1:N"];
    PERFIL -> RESENA [label="1:N"];
    PERFIL -> REPORTE [label="1:N"];
    CONTENIDO -> REPRODUCCION [label="1:N"];
    CONTENIDO -> FAVORITO [label="1:N"];
    CONTENIDO -> RESENA [label="1:N"];
    CONTENIDO -> REPORTE [label="1:N"];
    EMPLEADO -> REPORTE [label="1:N moderador" color="#ffc107"];

    USUARIO -> FACTURA [label="1:N" color="#dc3545"];
    FACTURA -> PAGO [label="1:N" color="#dc3545"];

    {rank=same; PLAN; CATEGORIA; GENERO; DEPARTAMENTO}
    {rank=same; EMPLEADO; CONTENIDO; TEMPORADA; EPISODIO}
    {rank=same; USUARIO; PERFIL; REFERIDO}
    {rank=same; REPRODUCCION; FAVORITO; RESENA; REPORTE}
    {rank=same; FACTURA; PAGO}
}
