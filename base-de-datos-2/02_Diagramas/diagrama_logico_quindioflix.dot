digraph QuindioFlix_Logico {
    graph [
        label="DIAGRAMA LÓGICO RELACIONAL - QUINDIOFLIX\nTransformación MER → 3FN"
        rankdir=LR
        nodesep=1.3
        ranksep=2.8
        pad=1.2
        fontsize=18
        fontname="Arial Bold"
        style=filled
        fillcolor=white
        bgcolor=white
    ];
    
    edge [
        color="#495057"
        penwidth=1.0
        arrowsize=0.4
        minlen=2.5
        labeldistance=3
        labelfontsize=9
        labelfontname="Arial Bold"
    ];
    
    node [
        shape=plain
        fontname="Arial"
        fontsize=9
    ];

    // =====================================================
    // 1. TABLAS MAESTRAS
    // =====================================================
    
    subgraph cluster_maestras {
        label="1. TABLAS MAESTRAS"
        bgcolor="#f8fff8"
        fontname="Arial Bold"
        fontsize=13
        style=filled
        penwidth=2
        color="#28a745"
        
        "PLAN" [
            label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="2" bgcolor="#d4edda">
<TR><TD COLSPAN="3" bgcolor="#28a745" align="center"><FONT COLOR="white"><B>PLAN</B></FONT></TD></TR>
<TR><TD align="left"><B>PK</B></TD><TD><U>plan_id</U></TD><TD>NUMBER(2)</TD></TR>
<TR><TD align="left"></TD><TD>nombre</TD><TD>VARCHAR2(20) NOT NULL UNIQUE</TD></TR>
<TR><TD align="left"></TD><TD>precio</TD><TD>NUMBER(10,2) NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>num_pantallas</TD><TD>NUMBER(1) NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>calidad</TD><TD>VARCHAR2(10) NOT NULL CHECK(IN('SD','HD','4K'))</TD></TR>
</TABLE>>
        ];
        
        "GENERO" [
            label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="2" bgcolor="#d4edda">
<TR><TD COLSPAN="3" bgcolor="#28a745" align="center"><FONT COLOR="white"><B>GENERO</B></FONT></TD></TR>
<TR><TD align="left"><B>PK</B></TD><TD><U>genero_id</U></TD><TD>NUMBER(3)</TD></TR>
<TR><TD align="left"></TD><TD>nombre</TD><TD>VARCHAR2(50) NOT NULL UNIQUE</TD></TR>
</TABLE>>
        ];
        
        "DEPARTAMENTO" [
            label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="2" bgcolor="#d4edda">
<TR><TD COLSPAN="3" bgcolor="#28a745" align="center"><FONT COLOR="white"><B>DEPARTAMENTO</B></FONT></TD></TR>
<TR><TD align="left"><B>PK</B></TD><TD><U>departamento_id</U></TD><TD>NUMBER(3)</TD></TR>
<TR><TD align="left"></TD><TD>nombre</TD><TD>VARCHAR2(50) NOT NULL UNIQUE</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>jefe_id</TD><TD>NUMBER(5)</TD></TR>
</TABLE>>
        ];
        
        "EMPLEADO" [
            label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="2" bgcolor="#d4edda">
<TR><TD COLSPAN="3" bgcolor="#28a745" align="center"><FONT COLOR="white"><B>EMPLEADO</B></FONT></TD></TR>
<TR><TD align="left"><B>PK</B></TD><TD><U>empleado_id</U></TD><TD>NUMBER(5)</TD></TR>
<TR><TD align="left"></TD><TD>nombre</TD><TD>VARCHAR2(100) NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>email</TD><TD>VARCHAR2(100) NOT NULL UNIQUE</TD></TR>
<TR><TD align="left"></TD><TD>telefono</TD><TD>VARCHAR2(20)</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>departamento_id</TD><TD>NUMBER(3)</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>supervisor_id</TD><TD>NUMBER(5)</TD></TR>
<TR><TD align="left"></TD><TD>cargo</TD><TD>VARCHAR2(50)</TD></TR>
</TABLE>>
        ];
    }

    // =====================================================
    // 2. CONTENIDO
    // =====================================================
    
    subgraph cluster_contenido {
        label="2. CONTENIDO MULTIMEDIA"
        bgcolor="#f0f8ff"
        fontname="Arial Bold"
        fontsize=13
        style=filled
        penwidth=2
        color="#007bff"
        
        "CONTENIDO" [
            label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="2" bgcolor="#e8f4fd">
<TR><TD COLSPAN="3" bgcolor="#007bff" align="center"><FONT COLOR="white"><B>CONTENIDO</B></FONT></TD></TR>
<TR><TD align="left"><B>PK</B></TD><TD><U>contenido_id</U></TD><TD>NUMBER(5)</TD></TR>
<TR><TD align="left"></TD><TD>titulo</TD><TD>VARCHAR2(200) NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>anno_lanzamiento</TD><TD>NUMBER(4) NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>duracion</TD><TD>NUMBER(5)</TD></TR>
<TR><TD align="left"></TD><TD>sinopsis</TD><TD>CLOB</TD></TR>
<TR><TD align="left"></TD><TD>clasificacion_edad</TD><TD>VARCHAR2(5) NOT NULL CHECK(IN('TP','+7','+13','+16','+18'))</TD></TR>
<TR><TD align="left"></TD><TD>fecha_agregado</TD><TD>DATE NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>tipo</TD><TD>VARCHAR2(20) NOT NULL CHECK(IN('PELICULA','SERIE','DOCUMENTAL','MUSICA','PODCAST'))</TD></TR>
<TR><TD align="left"></TD><TD>es_original</TD><TD>NUMBER(1) CHECK(IN(0,1))</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>contenido_relacionado_id</TD><TD>NUMBER(5)</TD></TR>
<TR><TD align="left"></TD><TD>tipo_relacion</TD><TD>VARCHAR2(30)</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>empleado_id</TD><TD>NUMBER(5)</TD></TR>
</TABLE>>
        ];
        
        "CONTENIDO_GENERO" [
            label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="2" bgcolor="#e8f4fd">
<TR><TD COLSPAN="3" bgcolor="#007bff" align="center"><FONT COLOR="white"><B>CONTENIDO_GENERO</B></FONT></TD></TR>
<TR><TD align="left"><B>PK</B></TD><TD><U>contenido_genero_id</U></TD><TD>NUMBER(5)</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>contenido_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>genero_id</TD><TD>NUMBER(3) NOT NULL</TD></TR>
</TABLE>>
        ];
        
        "TEMPORADA" [
            label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="2" bgcolor="#e8f4fd">
<TR><TD COLSPAN="3" bgcolor="#007bff" align="center"><FONT COLOR="white"><B>TEMPORADA</B></FONT></TD></TR>
<TR><TD align="left"><B>PK</B></TD><TD><U>temporada_id</U></TD><TD>NUMBER(5)</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>contenido_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>numero</TD><TD>NUMBER(2) NOT NULL</TD></TR>
</TABLE>>
        ];
        
        "EPISODIO" [
            label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="2" bgcolor="#e8f4fd">
<TR><TD COLSPAN="3" bgcolor="#007bff" align="center"><FONT COLOR="white"><B>EPISODIO</B></FONT></TD></TR>
<TR><TD align="left"><B>PK</B></TD><TD><U>episodio_id</U></TD><TD>NUMBER(5)</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>temporada_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>numero</TD><TD>NUMBER(3) NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>titulo</TD><TD>VARCHAR2(200) NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>duracion</TD><TD>NUMBER(5) NOT NULL</TD></TR>
</TABLE>>
        ];
    }

    // =====================================================
    // 3. USUARIOS
    // =====================================================
    
    subgraph cluster_usuarios {
        label="3. USUARIOS Y PERFILES"
        bgcolor="#fffcf0"
        fontname="Arial Bold"
        fontsize=13
        style=filled
        penwidth=2
        color="#ffc107"
        
        "USUARIO" [
            label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="2" bgcolor="#fff3cd">
<TR><TD COLSPAN="3" bgcolor="#ffc107" align="center"><FONT COLOR="white"><B>USUARIO</B></FONT></TD></TR>
<TR><TD align="left"><B>PK</B></TD><TD><U>usuario_id</U></TD><TD>NUMBER(5)</TD></TR>
<TR><TD align="left"></TD><TD>nombre</TD><TD>VARCHAR2(100) NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>email</TD><TD>VARCHAR2(100) NOT NULL UNIQUE</TD></TR>
<TR><TD align="left"></TD><TD>telefono</TD><TD>VARCHAR2(20)</TD></TR>
<TR><TD align="left"></TD><TD>fecha_nacimiento</TD><TD>DATE NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>ciudad_residencia</TD><TD>VARCHAR2(100)</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>plan_id</TD><TD>NUMBER(2) NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>fecha_registro</TD><TD>DATE NOT NULL</TD></TR>
</TABLE>>
        ];
        
        "PERFIL" [
            label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="2" bgcolor="#fff3cd">
<TR><TD COLSPAN="3" bgcolor="#ffc107" align="center"><FONT COLOR="white"><B>PERFIL</B></FONT></TD></TR>
<TR><TD align="left"><B>PK</B></TD><TD><U>perfil_id</U></TD><TD>NUMBER(5)</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>usuario_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>nombre</TD><TD>VARCHAR2(50) NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>avatar</TD><TD>VARCHAR2(200)</TD></TR>
<TR><TD align="left"></TD><TD>tipo</TD><TD>VARCHAR2(10) NOT NULL CHECK(IN('ADULTO','INFANTIL'))</TD></TR>
</TABLE>>
        ];
        
        "REFERIDO" [
            label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="2" bgcolor="#fff3cd">
<TR><TD COLSPAN="3" bgcolor="#ffc107" align="center"><FONT COLOR="white"><B>REFERIDO</B></FONT></TD></TR>
<TR><TD align="left"><B>PK</B></TD><TD><U>referido_id</U></TD><TD>NUMBER(5)</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>usuario_referidor_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>usuario_referido_id</TD><TD>NUMBER(5) NOT NULL UNIQUE</TD></TR>
<TR><TD align="left"></TD><TD>beneficio</TD><TD>VARCHAR2(100)</TD></TR>
<TR><TD align="left"></TD><TD>fecha</TD><TD>DATE NOT NULL</TD></TR>
</TABLE>>
        ];
    }

    // =====================================================
    // 4. CONSUMO
    // =====================================================
    
    subgraph cluster_consumo {
        label="4. CONSUMO Y REPRODUCCIONES"
        bgcolor="#fff0f5"
        fontname="Arial Bold"
        fontsize=13
        style=filled
        penwidth=2
        color="#e83e8c"
        
        "REPRODUCCION" [
            label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="2" bgcolor="#f8d7da">
<TR><TD COLSPAN="3" bgcolor="#e83e8c" align="center"><FONT COLOR="white"><B>REPRODUCCION</B></FONT></TD></TR>
<TR><TD align="left"><B>PK</B></TD><TD><U>reproduccion_id</U></TD><TD>NUMBER(10)</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>perfil_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>contenido_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>episodio_id</TD><TD>NUMBER(5)</TD></TR>
<TR><TD align="left"></TD><TD>fecha_inicio</TD><TD>TIMESTAMP NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>fecha_fin</TD><TD>TIMESTAMP</TD></TR>
<TR><TD align="left"></TD><TD>dispositivo</TD><TD>VARCHAR2(20) NOT NULL CHECK(IN('CELULAR','TABLET','TV','COMPUTADOR'))</TD></TR>
<TR><TD align="left"></TD><TD>porcentaje_avance</TD><TD>NUMBER(5,2) DEFAULT 0 CHECK(BETWEEN 0 AND 100)</TD></TR>
</TABLE>>
        ];
        
        "FAVORITO" [
            label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="2" bgcolor="#f8d7da">
<TR><TD COLSPAN="3" bgcolor="#e83e8c" align="center"><FONT COLOR="white"><B>FAVORITO</B></FONT></TD></TR>
<TR><TD align="left"><B>PK</B></TD><TD><U>favorito_id</U></TD><TD>NUMBER(10)</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>perfil_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>contenido_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>fecha_agregado</TD><TD>DATE NOT NULL</TD></TR>
</TABLE>>
        ];
        
        "RESENA" [
            label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="2" bgcolor="#f8d7da">
<TR><TD COLSPAN="3" bgcolor="#e83e8c" align="center"><FONT COLOR="white"><B>RESENA</B></FONT></TD></TR>
<TR><TD align="left"><B>PK</B></TD><TD><U>resena_id</U></TD><TD>NUMBER(10)</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>perfil_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>contenido_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>calificacion</TD><TD>NUMBER(1) NOT NULL CHECK(BETWEEN 1 AND 5)</TD></TR>
<TR><TD align="left"></TD><TD>texto</TD><TD>CLOB</TD></TR>
<TR><TD align="left"></TD><TD>fecha_publicacion</TD><TD>DATE NOT NULL</TD></TR>
</TABLE>>
        ];
        
        "REPORTE" [
            label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="2" bgcolor="#f8d7da">
<TR><TD COLSPAN="3" bgcolor="#e83e8c" align="center"><FONT COLOR="white"><B>REPORTE</B></FONT></TD></TR>
<TR><TD align="left"><B>PK</B></TD><TD><U>reporte_id</U></TD><TD>NUMBER(10)</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>contenido_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>perfil_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>motivo</TD><TD>VARCHAR2(500) NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>estado</TD><TD>VARCHAR2(20) DEFAULT 'PENDIENTE' CHECK(IN('PENDIENTE','REVISADO','APROBADO','RECHAZADO'))</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>empleado_id</TD><TD>NUMBER(5)</TD></TR>
<TR><TD align="left"></TD><TD>fecha_reporte</TD><TD>DATE NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>fecha_resolucion</TD><TD>DATE</TD></TR>
</TABLE>>
        ];
    }

    // =====================================================
    // 5. PAGOS
    // =====================================================
    
    subgraph cluster_pagos {
        label="5. PAGOS Y FACTURAS"
        bgcolor="#fff5f5"
        fontname="Arial Bold"
        fontsize=13
        style=filled
        penwidth=2
        color="#dc3545"
        
        "PAGO" [
            label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="2" bgcolor="#f8d7da">
<TR><TD COLSPAN="3" bgcolor="#dc3545" align="center"><FONT COLOR="white"><B>PAGO</B></FONT></TD></TR>
<TR><TD align="left"><B>PK</B></TD><TD><U>pago_id</U></TD><TD>NUMBER(10)</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>usuario_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>monto</TD><TD>NUMBER(10,2) NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>fecha_pago</TD><TD>DATE NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>metodo_pago</TD><TD>VARCHAR2(30)</TD></TR>
<TR><TD align="left"></TD><TD>referencia</TD><TD>VARCHAR2(100)</TD></TR>
</TABLE>>
        ];
        
        "FACTURA" [
            label=<
<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="2" bgcolor="#f8d7da">
<TR><TD COLSPAN="3" bgcolor="#dc3545" align="center"><FONT COLOR="white"><B>FACTURA</B></FONT></TD></TR>
<TR><TD align="left"><B>PK</B></TD><TD><U>factura_id</U></TD><TD>NUMBER(10)</TD></TR>
<TR><TD align="left"><B>FK</B></TD><TD>usuario_id</TD><TD>NUMBER(5) NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>periodo</TD><TD>VARCHAR2(7) NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>monto_total</TD><TD>NUMBER(10,2) NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>estado</TD><TD>VARCHAR2(20) DEFAULT 'PENDIENTE' CHECK(IN('PENDIENTE','PAGADA','VENCIDA'))</TD></TR>
<TR><TD align="left"></TD><TD>fecha_emision</TD><TD>DATE NOT NULL</TD></TR>
<TR><TD align="left"></TD><TD>fecha_vencimiento</TD><TD>DATE NOT NULL</TD></TR>
</TABLE>>
        ];
    }

    // =====================================================
    // RELACIONES CON CARDINALIDADES
    // =====================================================
    
    // CAPA 1 -> CAPA 1
    "PLAN" -> "USUARIO" [label="1:N" color="#28a745" penwidth=1.5];
    "DEPARTAMENTO" -> "EMPLEADO" [label="1:N" color="#28a745" penwidth=1.5];
    "DEPARTAMENTO" -> "DEPARTAMENTO" [label="1:1" color="#28a745" penwidth=1 style=dashed tailport=e headport=e];
    "EMPLEADO" -> "EMPLEADO" [label="1:N" color="#28a745" penwidth=1 style=dashed tailport=e headport=w];
    
    // CAPA 1 -> CAPA 2
    "EMPLEADO" -> "CONTENIDO" [label="1:N" color="#007bff" penwidth=1.5];
    
    // CAPA 2 internas
    "CONTENIDO" -> "CONTENIDO_GENERO" [label="1:N" color="#007bff" penwidth=1];
    "GENERO" -> "CONTENIDO_GENERO" [label="1:N" color="#007bff" penwidth=1];
    "CONTENIDO" -> "TEMPORADA" [label="1:N" color="#007bff" penwidth=1];
    "TEMPORADA" -> "EPISODIO" [label="1:N" color="#007bff" penwidth=1];
    "CONTENIDO" -> "CONTENIDO" [label="1:1" color="#007bff" penwidth=1 style=dashed tailport=s headport=n];
    
    // CAPA 3
    "USUARIO" -> "PERFIL" [label="1:N" color="#ffc107" penwidth=1.5];
    "USUARIO" -> "REFERIDO" [label="N:M" color="#ffc107" penwidth=1.5];
    "USUARIO" -> "PAGO" [label="1:N" color="#ffc107" penwidth=1.5];
    "USUARIO" -> "FACTURA" [label="1:N" color="#ffc107" penwidth=1.5];
    
    // CAPA 3 -> CAPA 4
    "PERFIL" -> "REPRODUCCION" [label="1:N" color="#e83e8c" penwidth=1.5];
    "PERFIL" -> "FAVORITO" [label="1:N" color="#e83e8c" penwidth=1.5];
    "PERFIL" -> "RESENA" [label="1:N" color="#e83e8c" penwidth=1.5];
    "PERFIL" -> "REPORTE" [label="1:N" color="#e83e8c" penwidth=1.5];
    
    // CAPA 2 -> CAPA 4
    "CONTENIDO" -> "REPRODUCCION" [label="1:N" color="#e83e8c" penwidth=1];
    "CONTENIDO" -> "FAVORITO" [label="1:N" color="#e83e8c" penwidth=1];
    "CONTENIDO" -> "RESENA" [label="1:N" color="#e83e8c" penwidth=1];
    "CONTENIDO" -> "REPORTE" [label="1:N" color="#e83e8c" penwidth=1];
    
    // CAPA 1 -> CAPA 4
    "EMPLEADO" -> "REPORTE" [label="1:N" color="#dc3545" penwidth=1];
    
    // Alineaciones horizontales por capas
    {rank=same; "PLAN","GENERO","DEPARTAMENTO","EMPLEADO"};
    {rank=same; "CONTENIDO","CONTENIDO_GENERO","TEMPORADA","EPISODIO"};
    {rank=same; "USUARIO","PERFIL","REFERIDO"};
    {rank=same; "REPRODUCCION","FAVORITO","RESENA","REPORTE"};
    {rank=same; "PAGO","FACTURA"};
}